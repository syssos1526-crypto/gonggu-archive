# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USER_ID: /admin 접근을 허용할 단 한 명의 관리자 auth user id (uuid).
# 서버 전용 — NEXT_PUBLIC_ 접두어를 붙이지 말 것. 값은 여기 채우지 말고
# .env.local(로컬)과 Vercel 환경변수(배포)에서만 직접 설정할 것.
ADMIN_USER_ID=

# SUPABASE_SECRET_KEY: 관리자 등록 기능(인플루언서/상품/공구 생성,
# Storage 업로드)이 RLS를 우회해 쓰기 작업을 수행할 때만 서버 코드에서 사용.
# 서버 전용 — NEXT_PUBLIC_ 접두어를 붙이지 말고, 절대 클라이언트 코드에서
# import하지 말 것. 값은 여기 채우지 말고 .env.local과 Vercel 환경변수에서만
# 직접 설정할 것.
# (기존 프로젝트에서 SUPABASE_SERVICE_ROLE_KEY만 있다면 코드가 fallback으로
# 인식하지만, 새로 설정할 때는 이 SUPABASE_SECRET_KEY를 사용할 것)
SUPABASE_SECRET_KEY=
